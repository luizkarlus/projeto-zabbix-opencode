# ==============================================================================
# Zabbix AI Lab — variáveis de ambiente
# O bootstrap.sh gera um .env com segredos aleatórios automaticamente.
# ==============================================================================

# --- Zabbix (PostgreSQL) ---
ZBX_DB_PASSWORD=troque-esta-senha

# --- WA-AKG (MySQL + app) ---
WA_MYSQL_ROOT_PASSWORD=troque-esta-senha
WA_AUTH_SECRET=gere-com-openssl-rand-base64-32
WA_ADMIN_EMAIL=admin@lab.local
WA_ADMIN_PASSWORD=troque-esta-senha

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# --- Ollama ---
# Modelo padrão do lab. Alternativa mais leve: llama3.2:3b
OLLAMA_MODEL=llama3.1:8b

# --- Geral ---
TZ=America/Sao_Paulo
